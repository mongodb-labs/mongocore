# Collect results into timestamped folder and generate README
bench-collect:
    cd collector && pip install -r requirements.txt -q && python collect.py

# Compare latest results against previous run
bench-compare:
    cd collector && python compare.py

# Check for performance regressions (exits non-zero if found)
bench-check-regression:
    cd collector && python check_regression.py

