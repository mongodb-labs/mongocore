# --- Private implementation recipes (just the benchmark, no infra) ---
# Each recipe skips if its result file already exists.

results_dir := justfile_directory() / "results"

[private]
_bench-python-native:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/python_native.json ]; then echo "  Skipping python-native (results exist)"; exit 0; fi
    cd drivers/python && pip install -r requirements.txt -q && python bench_native.py

[private]
_bench-python-mongocore:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/python_mongocore.json ]; then echo "  Skipping python-mongocore (results exist)"; exit 0; fi
    cd drivers/python && pip install -r requirements.txt -q && python bench_mongocore.py

[private]
_bench-typescript-native:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/typescript_native.json ]; then echo "  Skipping typescript-native (results exist)"; exit 0; fi
    cd drivers/typescript && npm install --silent && npx ts-node bench_native.ts

[private]
_bench-typescript-mongocore:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/typescript_mongocore.json ]; then echo "  Skipping typescript-mongocore (results exist)"; exit 0; fi
    cd drivers/typescript && npm install --silent && npx ts-node bench_mongocore.ts

[private]
_bench-go-native:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/go_native.json ]; then echo "  Skipping go-native (results exist)"; exit 0; fi
    cd drivers/go && go run bench_native.go

[private]
_bench-go-mongocore:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/go_mongocore.json ]; then echo "  Skipping go-mongocore (results exist)"; exit 0; fi
    cd drivers/go && go run bench_mongocore.go

[private]
_bench-java-native:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/java_native.json ]; then echo "  Skipping java-native (results exist)"; exit 0; fi
    cd drivers/java && mvn -q compile exec:java -Dexec.mainClass="com.mongocore.bench.BenchNative"

[private]
_bench-java-mongocore:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/java_mongocore.json ]; then echo "  Skipping java-mongocore (results exist)"; exit 0; fi
    cd drivers/java && mvn -q compile exec:java -Dexec.mainClass="com.mongocore.bench.BenchMongocore"

[private]
_bench-ingestion:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/ingestion.json ]; then echo "  Skipping ingestion (results exist)"; exit 0; fi
    cd ingestion && python generate_data.py && python bench_ingest.py

[private]
_bench-compiled:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/compiled_query.json ]; then echo "  Skipping compiled-query (results exist)"; exit 0; fi
    cd drivers/python && python bench_compiled.py

[private]
_bench-python-pipeline:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/python_pipeline.json ]; then echo "  Skipping python-pipeline (results exist)"; exit 0; fi
    cd drivers/python && pip install -r requirements.txt -q && python bench_pipeline.py

[private]
_bench-typescript-pipeline:
    #!/usr/bin/env bash
    if [ -f {{results_dir}}/typescript_pipeline.json ]; then echo "  Skipping typescript-pipeline (results exist)"; exit 0; fi
    cd drivers/typescript && npm install --silent && npx ts-node bench_pipeline.ts

[private]
_bench-go-pipeline:
