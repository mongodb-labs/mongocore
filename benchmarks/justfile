# MongoCore Benchmark Runner

set dotenv-load := false

# Path to root justfile directory (for docker-compose)
root := justfile_directory() / ".."

# Marker file indicating bench infrastructure is running
marker := "/tmp/mongocore-bench-ready"

# --- Infrastructure recipes ---

# Start benchmark infrastructure (Docker + sidecar, waits for sample data)
bench-setup:
    #!/usr/bin/env bash
    set -e
    cd {{justfile_directory()}}
    # Start Docker if needed
    if ! lsof -i :27017 -sTCP:LISTEN > /dev/null 2>&1; then
        echo ">>> Starting MongoDB (docker-compose)..."
        cd {{root}} && docker compose -f docker-compose.test.yml up -d
        cd {{justfile_directory()}}
    else
        echo ">>> MongoDB already running on :27017"
    fi
    # Wait for DB to accept connections
    echo ">>> Waiting for MongoDB to accept connections..."
    for i in $(seq 1 30); do
        if mongosh --quiet --eval "db.runCommand({ping:1})" mongodb://localhost:27017 > /dev/null 2>&1; then
            echo ">>> MongoDB ready"
            break
        fi
        sleep 1
        if [ "$i" -eq 30 ]; then
            echo "ERROR: MongoDB not ready after 30s"
            exit 1
        fi
    done
    # Kill any existing sidecar
    EXISTING_PID=$(lsof -ti :50051 -sTCP:LISTEN 2>/dev/null || true)
    if [ -n "$EXISTING_PID" ]; then
        echo ">>> Killing existing sidecar (PID $EXISTING_PID)..."
        kill $EXISTING_PID 2>/dev/null || true
        sleep 1
    fi
    # Build and start sidecar (sample data loads in parallel)
    echo ">>> Building MongoCore sidecar..."
    cd {{root}} && cargo build --release
    ./target/release/mongocore --connection-uri "mongodb://localhost:27017" &
    SIDECAR_PID=$!
    echo $SIDECAR_PID > /tmp/mongocore-bench-sidecar.pid
    cd {{justfile_directory()}}
    for i in $(seq 1 30); do
        if lsof -i :50051 -sTCP:LISTEN > /dev/null 2>&1; then
            echo ">>> MongoCore sidecar ready (PID $SIDECAR_PID)"
            break
        fi
        sleep 1
        if [ "$i" -eq 30 ]; then
            echo "ERROR: Sidecar failed to start within 30s"
            exit 1
        fi
    done
    # Generate benchmark data (while sample data continues loading)
    echo ">>> Generating benchmark data..."
    cd ingestion && python generate_data.py && cd ..
    # Now wait for sample data (needed by compiled query benchmarks)
    echo ">>> Waiting for sample data to load..."
    echo "    Atlas sample datasets are loaded async by the mongodb-atlas-local container."
    for i in $(seq 1 60); do
        COUNT=$(mongosh --quiet --eval "db.getSiblingDB('sample_restaurants').restaurants.countDocuments()" mongodb://localhost:27017 2>/dev/null || echo "0")
        if [ "$COUNT" -gt "0" ] 2>/dev/null; then
            echo ">>> Sample data ready ($COUNT restaurants loaded)"
            break
        fi
        if [ $((i % 10)) -eq 0 ]; then
            echo "    Still waiting... ($((i*2))s elapsed)"
        fi
        sleep 2
        if [ "$i" -eq 60 ]; then
            echo "ERROR: Sample data not loaded after 120s."
            echo "       Make sure docker-compose is using mongodb/mongodb-atlas-local with MONGODB_LOAD_SAMPLE_DATA=true"
            exit 1
        fi
    done
    # Mark infrastructure as ready
    touch {{marker}}
    echo ">>> Benchmark infrastructure ready (MongoDB + sample data + sidecar)"

# Stop all benchmark infrastructure (Docker + sidecar)
bench-teardown:
    #!/usr/bin/env bash
    cd {{justfile_directory()}}
    PID=$(cat /tmp/mongocore-bench-sidecar.pid 2>/dev/null || true)
    if [ -n "$PID" ]; then
        kill $PID 2>/dev/null || true
        rm -f /tmp/mongocore-bench-sidecar.pid
        echo ">>> Sidecar stopped"
    fi
    cd {{root}} && docker compose -f docker-compose.test.yml down
    rm -f {{marker}}
    echo ">>> All benchmark infrastructure stopped"

# --- Private: check infrastructure is running ---

[private]
require-setup:
    #!/usr/bin/env bash
    if [ ! -f {{marker}} ]; then
        echo "ERROR: Benchmark infrastructure not running."
        echo ""
        echo "  Run 'just bench-setup' first to start MongoDB + sidecar."
        echo "  Run 'just bench-teardown' when done to clean up."
        echo ""
        exit 1
    fi

# --- Main benchmark recipes ---

# Run all benchmarks (runs setup, all benchmarks, then teardown)
# Skips benchmarks that already have results — delete a result file to force rerun,
# or use `just bench-clean` to wipe all results.
bench-all:
    #!/usr/bin/env bash
    set -e
    cd {{justfile_directory()}}
    just bench-setup
    echo "==================================="
    echo "  MongoCore Benchmark Suite"
    echo "==================================="
    echo ""
    echo ">>> Running driver benchmarks..."
    just _bench-python-native
    just _bench-python-mongocore
    just _bench-typescript-native
    just _bench-typescript-mongocore
    just _bench-go-native
    just _bench-go-mongocore
    just _bench-java-native
    just _bench-java-mongocore
    echo ""
    echo ">>> Running pipeline benchmarks..."
    just _bench-python-pipeline
    just _bench-typescript-pipeline
    just _bench-go-pipeline
    just _bench-java-pipeline
    echo ""
    echo ">>> Running ingestion benchmarks..."
    just _bench-ingestion
    echo ""
    echo ">>> Generating report..."
    just bench-report
    echo ""
    echo "==================================="
    echo "  BENCHMARKS COMPLETE"
    echo "  Results: benchmarks/results/"
    echo "  Report:  benchmarks/RESULTS.md"
    echo ""
    echo "  Run 'just bench-teardown' to stop MongoDB + sidecar."
    echo "==================================="

# Sidecar internal benchmarks (no MongoDB needed)
bench-rust:
    cd rust && cargo bench

# Remove all result files to force a full rerun
bench-clean:
    rm -f results/*.json
    @echo "Results cleaned — next bench run will execute all benchmarks"

# Generate RESULTS.md from current result files
bench-report:
    pip install -r requirements.txt -q && python generate_results.py

# All driver benchmarks (native + MongoCore, all languages)
